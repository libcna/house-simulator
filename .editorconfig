# cna-house — editor defaults. Matches CNA's own source style (docs/conventions.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 110

[*.{md,markdown}]
max_line_length = 100
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{cmake,txt}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 4
