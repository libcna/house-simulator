{
  // The property outside the house: the ground it stands on, the road, the fences and gates that
  // bound it, the paved surfaces you walk on and the one building that is not the house.
  // `HOUSE-00390`. `HOUSE-00391` adds the neighbourhood instances and `HOUSE-00392` the planting.
  //
  // Every coordinate here is §10.2's origin: the centre of the pedestrian gate opening in the
  // front fence, at finished grade. The gate, the front walk and the front door share X = 0.
  "schema": "cna-house/exterior/1",

  // §11.5's height field: a 1.0 m grid over §10.3's playable volume, 81 x 65 samples. Generated by
  // `tools/world/terrain_gen.py` (`HOUSE-00761`) from the surfaces below and §10.2's slope, with
  // `terrain.json` beside it saying how to read it: sample 0 is `origin.y` and 65535 is
  // `origin.y + yScale`, so the lot's +0.15 at the front line falling to -0.35 at the rear fence
  // uses a hundredth of the range and nothing is re-encoded when a bank or a swale is added.
  //
  // A **PNG**, per §11.5, and not the `.r16` this file said before `HOUSE-00761` wrote it: the
  // format's example named a raw blob and §11.5 asks for a 16-bit PNG, which is lossless, opens
  // everywhere and does not need a second tool to look at.
  "terrain": {
    "heightfield": "world/terrain.png",
    "materialIndex": "world/terrain_materials.png",
    "size": [80.0, 64.0],
    "samples": [81, 65],
    "step": 1.0,
    "origin": [-40.0, -3.0, -52.0],
    "yScale": 6.0,
    "material": "MAT_GROUND_LAWN",
    // §11.5's eight classes, in the order the index uses: an index is a position in this list.
    "materials": ["grass", "lawn_worn", "soil", "gravel", "concrete", "asphalt", "bluestone",
                  "mulch"]
  },

  // §11.4's carriageway: 7.0 m of asphalt between kerbs at Z +3.2 and +10.2, so the centreline is
  // Z +6.7. It runs the full visual length and not just §10.4's accessible +/-35: the geometry
  // continues past where the player can walk, which is what makes the barrier believable.
  "road": {
    "centreline": [[-220.0, 0.0, 6.7], [220.0, 0.0, 6.7]],
    "width": 7.0,
    "material": "MAT_ASPHALT_01"
  },

  // §11.4's two kerbs, ours and the mirrored far side, 0.15 m.
  "kerbs": [
    { "id": "KERB_NEAR", "path": [[-220.0, 0.0, 3.2], [220.0, 0.0, 3.2]],
      "height": 0.15, "material": "MAT_CONCRETE_KERB" },
    { "id": "KERB_FAR", "path": [[-220.0, 0.0, 10.2], [220.0, 0.0, 10.2]],
      "height": 0.15, "material": "MAT_CONCRETE_KERB" }
  ],

  // §11.2. The front is ornamental and 1.35 m; the three boundaries are 1.85 m board. The front
  // fence is three runs because the two gates are holes in it, and a fence drawn through its own
  // gate is the kind of thing nobody notices until they walk at it.
  "fences": [
    { "id": "EXT_FENCE_FRONT_W", "asset": "MODEL_FENCE_ORNAMENTAL_01",
      "path": [[-22.5, 0.0, 0.0], [-0.6, 0.0, 0.0]], "height": 1.35, "gate": null },
    { "id": "EXT_FENCE_FRONT_C", "asset": "MODEL_FENCE_ORNAMENTAL_01",
      "path": [[0.6, 0.0, 0.0], [10.2, 0.0, 0.0]], "height": 1.35, "gate": null },
    { "id": "EXT_FENCE_FRONT_E", "asset": "MODEL_FENCE_ORNAMENTAL_01",
      "path": [[16.2, 0.0, 0.0], [22.5, 0.0, 0.0]], "height": 1.35, "gate": null },
    { "id": "EXT_FENCE_W", "asset": "MODEL_FENCE_BOARD_01",
      "path": [[-22.5, 0.0, 0.0], [-22.5, 0.0, -48.0]], "height": 1.85, "gate": null },
    { "id": "EXT_FENCE_E", "asset": "MODEL_FENCE_BOARD_01",
      "path": [[22.5, 0.0, 0.0], [22.5, 0.0, -48.0]], "height": 1.85, "gate": null },
    { "id": "EXT_FENCE_N_W", "asset": "MODEL_FENCE_BOARD_01",
      "path": [[-22.5, 0.0, -48.0], [18.55, 0.0, -48.0]], "height": 1.85, "gate": null },
    { "id": "EXT_FENCE_N_E", "asset": "MODEL_FENCE_BOARD_01",
      "path": [[19.45, 0.0, -48.0], [22.5, 0.0, -48.0]], "height": 1.85, "gate": null }
  ],

  // §11.2's three gates, each naming the row that operates it (`HOUSE-00416`). They were null
  // until then, because `interactables.json` held only light switches; rule 6 checks them now.
  "gates": [
    { "id": "EXT_GATE_PED", "fence": "EXT_FENCE_FRONT_W", "kind": "hinged", "hinge": "east",
      "opening": { "x": [-0.60, 0.60], "z": [-0.05, 0.05] }, "height": 1.35,
      "asset": "MODEL_GATE_PED_01", "interactable": "GATE_PED" },
    { "id": "EXT_GATE_DRIVE", "fence": "EXT_FENCE_FRONT_C", "kind": "sliding",
      "opening": { "x": [10.20, 16.20], "z": [-0.05, 0.05] }, "height": 1.35,
      "asset": "MODEL_GATE_DRIVE_01", "interactable": "GATE_DRIVE" },
    { "id": "EXT_GATE_REAR", "fence": "EXT_FENCE_N_W", "kind": "bolted",
      "opening": { "x": [18.55, 19.45], "z": [-48.05, -47.95] }, "height": 1.85,
      "asset": "MODEL_GATE_REAR_01", "interactable": "GATE_REAR" }
  ],

  // The paved surfaces of §11.4 and §11.6. The driveway is two boxes because §11.6 has it 7.2 m
  // wide at the gate and narrowing to the garage apron, and a taper is two rectangles until the
  // geometry builder makes it one.
  "paths": [
    { "id": "PATH_WALK", "kind": "walk", "boxes": [{ "x": [-1.0, 1.0], "z": [-11.6, 0.0] }],
      "y": 0.0, "material": "MAT_BLUESTONE_PAVER" },
    { "id": "PATH_DRIVEWAY", "kind": "driveway",
      "boxes": [{ "x": [9.6, 16.8], "z": [-6.0, 0.0] },
                { "x": [9.3, 17.1], "z": [-13.3, -6.0] }],
      "y": 0.0, "material": "MAT_CONCRETE_BROOM" },
    { "id": "PATH_APRON", "kind": "apron", "boxes": [{ "x": [9.3, 17.1], "z": [-13.3, -13.0] }],
      "y": 0.0, "material": "MAT_CONCRETE_BROOM" },
    // §11.3's connector: "a 1.0 m concrete path links the driveway to the front walk at z = -6.0
    // so the player never has to cross grass". It was the one paved surface §11 describes and this
    // file did not have (`HOUSE-00764`). A `walk` rather than a kind of its own: it is a path a
    // person walks on, which is what that kind means, and the schema's list is closed.
    { "id": "PATH_CONNECT", "kind": "walk", "boxes": [{ "x": [1.0, 9.6], "z": [-6.5, -5.5] }],
      "y": 0.0, "material": "MAT_CONCRETE_BROOM" },
    { "id": "PATH_SIDEWALK_NEAR", "kind": "sidewalk",
      "boxes": [{ "x": [-220.0, 220.0], "z": [1.6, 3.2] }],
      "y": 0.02, "material": "MAT_CONCRETE_SLAB" },
    { "id": "PATH_SIDEWALK_FAR", "kind": "sidewalk",
      "boxes": [{ "x": [-220.0, 220.0], "z": [10.2, 11.8] }],
      "y": 0.02, "material": "MAT_CONCRETE_SLAB" },
    { "id": "PATH_VERGE_NEAR", "kind": "verge",
      "boxes": [{ "x": [-220.0, 220.0], "z": [0.0, 1.6] }],
      "y": 0.0, "material": "MAT_GROUND_LAWN" },
    // The leg to the shed door moved east by `HOUSE-00769`. It ran x -19.0…-18.2 over
    // z -43.8…-38.6, which is three metres INSIDE the shed (x -19.8…-16.6, z -43.8…-40.6) and
    // reaches no door: the shed's is on its EAST face at x = -16.6. It now runs down that face,
    // from the main path to the threshold, starting at x = -16.4 -- the OUTSIDE of the shed's
    // wall, because §11.6's footprint is the cell plus the wall and a path that starts at the
    // cell's own face is a path through 0.20 m of timber (rule 12).
    { "id": "PATH_GARDEN", "kind": "garden",
      "boxes": [{ "x": [-19.0, -13.0], "z": [-38.6, -37.8] },
                { "x": [-16.4, -15.6], "z": [-42.6, -38.6] }],
      "y": 0.0, "material": "MAT_GRAVEL_PATH" }
  ],


  // §11.4's neighbourhood: 60 buildings and the street furniture, none of it enterable.
  // `HOUSE-00391`. Positions are deterministic -- a fixed seed for the jitter -- so the street
  // looks the same in every build and a screenshot comparison means something.
  //
  // The neighbours' porch lights are the exception §53 promised and `HOUSE-00383` deferred: they
  // are two lights per N1/N2 facade, in `layout.lights.json`, because their positions ARE these
  // positions and there was nothing to hang them on until now.
  // `HOUSE-00843`, ADR-0013: a house's PALETTE is in its asset id, and the variant is generated by
  // `neighbourhood_gen.py` from `HOUSE-00841`'s grammar -- there is no per-instance material
  // override, in this file or at runtime. The assignment is deterministic and neighbourly: houses
  // are walked in street order (by depth band, then along x) and each takes the first of §11.4's
  // eight palettes not already used within 30 m across and 10 m deep, so no two houses you can see
  // together are painted alike. Nineteen variants out of a possible forty-eight, because nineteen
  // is what these twenty-four rows name.
  "neighbourhood": [
    // ---- N1-N2 x2 -- the two immediately adjacent houses, same street, full facades and roofs,
    // real windows with interior-glow cards at night.
