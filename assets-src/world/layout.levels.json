        "id": "DUCT_L1_CENTRE", "trunk": "joist space below",
        "cells": ["L1_LANDING", "L1_STAIR_MAIN", "L1_HALL", "L1_MASTER_BED"],
        "registers": [
          { "cell": "L1_LANDING", "position": [0.60, 3.67, -16.90], "kind": "floor" },
          { "cell": "L1_STAIR_MAIN", "position": [4.15, 3.67, -17.85], "kind": "floor" },
          { "cell": "L1_HALL", "position": [0.60, 3.67, -20.75], "kind": "floor" },
          { "cell": "L1_MASTER_BED", "position": [-1.80, 3.67, -25.15], "kind": "floor" }
