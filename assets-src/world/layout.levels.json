          { "cell": "B1_STOR1", "position": [-9.85, 0.15, -20.75], "kind": "ceiling" },
          { "cell": "B1_STOR2", "position": [-9.85, 0.15, -25.15], "kind": "ceiling" },
          { "cell": "B1_HOBBY", "position": [-4.60, 0.15, -21.75], "kind": "ceiling" },
