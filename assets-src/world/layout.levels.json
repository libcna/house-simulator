    "plant": {
      "cell": "B1_MECHANICAL", "position": [6.80, -1.40, -16.30],
      // §12.5: "a vertical chase X +2.20…+2.60 beside the stair serves L1/L2/L3".
      "chase": { "x": [2.20, 2.60], "z": [-20.20, -19.40] }
    },
    "branches": [
      {
        "id": "DUCT_B1_EAST", "trunk": "basement ceiling",
        "cells": ["B1_UTILITY", "B1_CINEMA", "B1_WC7"],
        "registers": [
          { "cell": "B1_UTILITY", "position": [7.40, 0.15, -22.40], "kind": "ceiling" },
          { "cell": "B1_CINEMA", "position": [6.05, 0.15, -25.65], "kind": "ceiling" },
          { "cell": "B1_WC7", "position": [3.60, 0.15, -22.70], "kind": "ceiling" }
        ]
      },
