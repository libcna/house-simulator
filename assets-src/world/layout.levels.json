{
  // The five levels and the construction constants everything else derives from.
  // `cna-house.md` §12.2 (elevations) and §12.3 (dimensions) are the authority; this file is the
  // data. Metres, right-handed, Y up, -Z north (§14).
  "schema": "cna-house/levels/1",
  "units": "metres",
  "north": "-Z",

  // `ffl` is finished floor level; `ceiling` is the underside of the ceiling above it. The gap
  // between one ceiling and the next `ffl` is `structureDepth`: 0.35 m of engineered joists,
  // subfloor and finish. Every one of these is checkable -- 0.25 + 0.35 = 0.60, 3.30 + 0.35 =
  // 3.65, 6.20 + 0.35 = 6.55, 9.00 + 0.30 = 9.30 -- and the attic is the one that is not, because
  // its floor sits on a shallower deck over the collar ties.
  "levels": [
    { "id": "B1", "name": "Basement",      "ffl": -2.30, "ceiling":  0.25, "structureDepth": 0.35 },
    { "id": "L0", "name": "Main Floor",    "ffl":  0.60, "ceiling":  3.30, "structureDepth": 0.35 },
    { "id": "L1", "name": "Upper Floor 1", "ffl":  3.65, "ceiling":  6.20, "structureDepth": 0.35 },
    { "id": "L2", "name": "Upper Floor 2", "ffl":  6.55, "ceiling":  9.00, "structureDepth": 0.35 },

    // The attic's `ceiling` is null because it is bounded by rafters, not by a plane: 1.20 m at
    // the knee wall rising to 5.00 m at the ridge. `null` here is "there is no ceiling plane",
    // never "the ceiling is at zero", and every cell on this level therefore declares its own
    // `yOverride` -- `WorldData::ExtentOf` refuses rather than inventing one.
    { "id": "L3", "name": "Attic",         "ffl":  9.30, "ceiling": null,  "structureDepth": 0.30,
      "roof": "ROOF_MAIN" }
  ],

  // §12.5's HVAC row, as data. `HOUSE-00387`. Beside `plumbing` and for the same
  // reasons: the plant, the chase and the branches are house-wide constants, and
  // §62.6 puts the duct rumble and tick "at each register", which needs the
  // registers to exist somewhere. They live here and not as 43 more audio emitters:
  // an emitter per register would be the same fact written twice.
  //
  // Branch membership is NOT repeated from the cells -- each branch lists the cells
  // that name it in `thermal.ductBranch`, and §15.7 rule 6 checks the two against
  // each other the way it checks a cell's `lightGroups` against its lights.
  //
  // A register is in the FLOOR upstairs, where the branch runs in the joist space
  // below, and in the CEILING in the basement, where the trunk is exposed under the
  // L0 slab -- which is also why §62.6's rumble is loudest in `B1`.
