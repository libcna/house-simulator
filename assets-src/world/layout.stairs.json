{
  // §12.4's flights, as data. `HOUSE-00379`.
  //
  // `rise` is a magnitude and `risers × rise` is the height the flight climbs; direction is
  // `fromCell` → `toCell`. §15.7 rule 8 checks that climb against the two levels' FFLs, and for a
  // flight between two cells on the SAME level -- the porch steps, the terrace steps, the garage
  // steps -- against the `fromY`/`toY` this file declares, because two cells on one level have no
  // level difference to check against and the flight is the only thing that knows.
  //
  // §70.5's `2·rise + going ∈ [600, 650] mm` holds for every flight here. Exterior steps may
  // exceed the upper bound and do: the porch is 680 mm, which is a shallower, deeper step than the
  // rule asks for and is the right thing outdoors. They may not go under it -- a steep step is a
  // steep step in the rain as much as on the landing.
  "schema": "cna-house/stairs/1",
  "flights": [
    {
      // §12.4's 17 × 179.4 mm is 3.05 m / 17 exactly; the table rounds to a tenth of a
      // millimetre and this is the number it rounds. The turn follows riser 9, making the
      // two flights comparable in length while retaining headroom over the basement run.
      "id": "STAIR_MAIN_L0_L1",
      "fromCell": "L0_STAIR_MAIN", "toCell": "L1_STAIR_MAIN",
      "risers": 17, "rise": 0.1794118, "going": 0.280, "width": 1.10,
      // The west first run faces the foyer, with a metre of level approach. The upper cross
      // landing returns to the south wall and the west L1 doorway, not to the first tread.
      "footprint": { "x": [2.20, 4.90], "z": [-20.20, -14.30] },
      "run": "-Z", "shape": "u", "firstRunAt": "cross_lo", "approachDepth": 1.00,
      "topLandingToFoot": true, "topCrossLandingDepth": 0.28,
      "landings": [{ "at": 9, "depth": 2.38 }],
      "collisionRamp": true, "surface": "stair_carpet"
    },
    {
      // 2.90 m / 16. Two eight-riser flights keep the upper switchback equally legible.
      "id": "STAIR_MAIN_L1_L2",
      "fromCell": "L1_STAIR_MAIN", "toCell": "L2_STAIR_MAIN",
      "risers": 16, "rise": 0.1812500, "going": 0.280, "width": 1.10,
      "footprint": { "x": [2.20, 4.90], "z": [-20.20, -14.30] },
      "run": "-Z", "shape": "u", "firstRunAt": "cross_lo", "approachDepth": 1.00,
      "topLandingToFoot": true,
      "topCrossLandingDepth": 0.00,
      "landings": [{ "at": 8, "depth": 2.66 }],
      "collisionRamp": true, "surface": "stair_carpet"
    },
    {
      // 2.75 m / 15, straight, north-running, and narrower because it serves the attic.
      // A 1.00 m level entry fits behind the L2 side door; the adjacent service bath
      // gives up 1.00 m of its depth so the flight can start naturally and keep a
      // domestic 250 mm going. The attic head has a separate level turning landing.
      "id": "STAIR_ATTIC_L2_L3",
      "fromCell": "L2_STAIR_ATTIC", "toCell": "L3_STAIR_HEAD",
      "risers": 15, "rise": 0.1833333, "going": 0.250, "width": 0.90,
      "footprint": { "x": [5.40, 8.20], "z": [-19.30, -14.30] },
      "run": "-Z", "shape": "straight", "approachDepth": 1.00,
      "landings": [],
      "collisionRamp": true, "surface": "stair_wood_open"
    },
    {
      // Straight, south-running beneath the main stair. The B1 hall enters near the north foot;
      // A metre of level floor connects the north hall door to the first tread;
      // the head reaches L0's free south approach strip instead of an open floor-well edge.
      "id": "STAIR_BASEMENT_L0_B1",
      "fromCell": "B1_STAIR", "toCell": "L0_STAIR_MAIN",
      "risers": 16, "rise": 0.1812500, "going": 0.250, "width": 1.00,
      "footprint": { "x": [2.20, 4.90], "z": [-20.20, -14.30] },
      "run": "+Z", "shape": "straight", "approachDepth": 1.00,
      "landings": [],
      "collisionRamp": true, "surface": "concrete"
    },
    {
      // The three porch steps. 2·190 + 300 = 680 mm: outside §70.5's band, deliberately, and
      // §12.4 marks it "(exterior, permitted)".
      "id": "STEPS_PORCH",
      "fromCell": "EXT_WALK", "toCell": "L0_PORCH",
      "risers": 3, "rise": 0.190, "going": 0.300, "width": 3.00,
      "fromY": 0.00, "toY": 0.57,
      "footprint": { "x": [-1.50, 1.50], "z": [-11.60, -10.70] },
      "run": "-Z", "shape": "straight",
      "landings": [],
      "collisionRamp": true, "surface": "bluestone"
    },
    {
      // The single step up from the terrace into the sunroom -- §16.1's "one step down" beside
      // the slider, from this side. Like the other exterior flights, its collision uses
      // the authored run as a ramp: a slow approach must not balance repeatedly on the
      // capsule's rounded contact with the single riser. Centre on the actual slider at
      // X=-2.00, not the house origin; meet the sunroom's inner slab edge at Z=-32.25.
      "id": "STEPS_TERRACE",
      "fromCell": "EXT_TERRACE", "toCell": "L0_SUNROOM",
      "risers": 1, "rise": 0.150, "going": 0.350, "width": 3.60,
      "fromY": 0.45, "toY": 0.60,
      "footprint": { "x": [-3.80, -0.20], "z": [-32.60, -32.25] },
      "run": "+Z", "shape": "straight",
      "landings": [],
      "collisionRamp": true, "surface": "bluestone"
    },
    {
      // `HOUSE-00379`. Not in §12.4, and the terrace cannot be reached without it: the deck is
      // +0.45 and the lawn is grade, so there are three steps between them and §12.4 scheduled
      // none. Added there with this row.
      "id": "STEPS_TERRACE_LAWN",
      "fromCell": "EXT_BACKYARD", "toCell": "EXT_TERRACE",
      "risers": 3, "rise": 0.150, "going": 0.350, "width": 3.00,
      "fromY": 0.00, "toY": 0.45,
      "footprint": { "x": [-1.50, 1.50], "z": [-37.05, -36.00] },
      "run": "+Z", "shape": "straight",
      "landings": [],
      "collisionRamp": true, "surface": "bluestone"
    },
    {
      // Garage slab +0.15 to mudroom +0.60, inside the garage at the house wall. §12.4 gave the
      // going as 280 mm, which makes 2·150 + 280 = 580 -- below §70.5's band. 300 mm makes it
      // exactly 600, and the flight has the room; corrected in §12.4.
      "id": "STEPS_GARAGE",
      "fromCell": "L0_GARAGE", "toCell": "L0_MUDROOM",
      "risers": 3, "rise": 0.150, "going": 0.300, "width": 1.10,
      "fromY": 0.15, "toY": 0.60,
      "footprint": { "x": [8.70, 9.60], "z": [-16.85, -15.75] },
      "run": "-X", "shape": "straight",
      "landings": [],
      "collisionRamp": true, "surface": "concrete"
    }
  ]
}
