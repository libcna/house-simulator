    // ================================================================== the doors
    // `HOUSE-00401`. 64 rows: every leaf in the house that swings, slides or lifts on a frame,
    // which is `layout.openings.json`'s doors less the refrigerator's and the two hatches -- those
    // belong to the container and hatch tasks.
    //
    // The opening is the geometry and this is the thing you use: `docs/world-format.md` says an
    // opening "pairs with exactly one portal and with one interactable", and these are those
    // interactables. Each names its portal, so the visibility, audio and pet systems all reach the
    // same door through the row they already hold.
    //
    // `openFraction` is continuous, not a boolean: §54 swings a door 100 degrees over 0.6 s and
    // §65.6 starts one of these at 0.35. A door that is either open or shut cannot be ajar.
    //
    // The focus is the handle: away from the hinge, 1.05 m up, 0.06 m inside the room the leaf
    // opens into -- so §15.7 rule 11 proves all 64 reachable from somewhere a player can stand,
    // the way it proved the 80 switch plates.
    //
    // Three are named as §65.6 names them -- `DOOR_L1_MASTER`, `DOOR_L0_PANTRY`, `DOOR_L2_ATTIC`
    // -- because a save delta that references a door by a name the design already published should
    // not have to be translated. The rest are `DOOR_` plus the room the leaf opens into.
    {
      "id": "DOOR_B1_MECHANICAL", "kind": "door", "cell": "B1_MECHANICAL",
      "prop": null,
      "focus": { "point": [4.96, -1.25, -15.94], "normal": [1.0, 0.0, 0.0], "radius": 0.35 },
      "bounds": { "min": [4.87, -2.30, -16.75], "max": [4.93, -0.20, -15.85] },
      "actions": [
        { "verb": "Open", "when": "state.openFraction < 0.05 && state.locked == false",
          "do": "state.openFraction = 1.0", "sound": "SFX_DOOR_OPEN", "anim": "leaf", "duration": 0.6 },
        { "verb": "Close", "when": "state.openFraction > 0.05",
          "do": "state.openFraction = 0.0", "sound": "SFX_DOOR_CLOSE", "anim": "leaf", "duration": 0.5 }
      ],
      "state": { "openFraction": 0.0, "latched": true, "locked": false },
      "persist": ["openFraction"],
      "portal": "P_B1_STAIR__B1_MECHANICAL"
    },
    {
