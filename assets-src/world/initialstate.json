  // The delta. Everything §65.6 lists as "all closed", "all off" or "all zero" is the default and
  // is therefore absent: the four rows below are the only things that do not start at rest.
  //
  // These four ids are an obligation on the task that authors the door and window interactables.
  // `interactables.json` holds the 79 current switch plates, so none of the four
  // resolves yet -- exactly like the `MAT_*` references in `layout.openings.json`, and rule 6
  // will hold this file to them the moment those rows exist.
  "interactables": {
    // Ajar, so the first upstairs door you meet is already telling you doors move.
    "DOOR_L1_MASTER": { "openFraction": 0.35 },
    // Wide open: §13.3 puts the chest freezer in here and the pantry is a working room.
    "DOOR_L0_PANTRY": { "openFraction": 1.00 },
    // Closed, and listed anyway, because §65.6 says so: the attic is a discovery and a reader of
    // this file should not have to infer that from an absence.
    "DOOR_L2_ATTIC":  { "openFraction": 0.00 },
    // The one open window, so weather audio through an opening is testable from the first minute.
    "WIN_L1_MASTER_N2": { "openFraction": 0.50 }
  },

