        "shellHash": "sha256:2d43bece7157ec8fa824a3c2cd8e81bce9872fc744754731533b29d2b0d46781",
        "daylight": {
          "contentName": "Textures/Lightmaps/Daylight/L3_STAIR_HEAD_LM_DAY",
          "scale": 1.0000001192092896,
          "receiverMean": 0.36499637430673465
