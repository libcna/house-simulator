    // ---------------------------------------------------------------------------- L3, §13.6 ----
    // Attic. Floor +9.30, and no ceiling plane at all: knee walls 1.20 m tall stand 1.60 m in from
    // the eaves, the finished part has a collar-tie ceiling at +12.60, and the rest is open to the
    // rafters up to the ridge at +14.30.
    //
    // Every cell here therefore declares its own `yOverride` -- `layout.levels.json` gives `L3` a
    // null ceiling and `WorldData::ExtentOf` refuses to invent one, which is the whole point of
    // that null. The upper bound is §13.6's MAXIMUM head-room plus the floor: a cell is an
    // axis-aligned bounding volume and the rafter slope inside it is geometry, not extent.
    //
    // `L3_STAIR_HEAD` takes the same full-bay correction as `L2_STAIR_ATTIC` below it, and the six
    // cells then cover 273.9 m² -- the envelope, and the same total as every other level.
    {
      "id": "L3_STAIR_HEAD", "level": "L3", "name": "Attic Stair Head", "kind": "stair",
      // The northern 1.15 m is the level landing needed to turn into either attic exit.
      "boxes": [{ "x": [4.90, 8.70], "z": [-20.20, -14.30] }],
      // 2.2 → 3.4 m: the dormer above the head is what gives standing room at the top of a stair
      // that would otherwise arrive under a rafter.
      "yOverride": [9.30, 12.70],
      "floorMaterial": "MAT_WOOD_OAK_FLOOR", "wallMaterial": "MAT_PAINT_AGED_PLASTER",
      "ceilingMaterial": "MAT_PAINT_CEILING_ATTIC", "trimMaterial": "MAT_HATCH_PLY",
      "footstepSurface": "stair_wood",
      "acoustic": { "roomTone": "AMB_ATTIC", "absorption": 0.18, "reverbHint": "narrow_hard" },
      "thermal": { "heated": false, "ductBranch": null },
      "lightGroups": ["LG_L3_STAIR_HEAD_MAIN"],
