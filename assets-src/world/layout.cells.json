      // is a horizontal one -- `plane.axis: "y"` -- which is the second thing that case was added
      // for after the stair well (`HOUSE-00358`).
      "boxes": [{ "x": [-12.40, -11.00], "z": [-26.90, -26.20] }],
      "yOverride": [0.75, 1.35],
      "footstepSurface": null,
      "acoustic": { "absorption": 0.22, "reverbHint": "tiny_hard" },
      "thermal": { "heated": false, "ductBranch": null },
